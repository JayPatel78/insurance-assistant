# Copy this file to .env and fill it in. .env is git-ignored.

# Postgres + pgvector, running in Docker on port 5434 (step 1)
DATABASE_URL=postgres://assistant:assistant@localhost:5434/assistant

# Gemini API key from https://aistudio.google.com/apikey (needed from step 2, for embeddings)
GOOGLE_API_KEY=
